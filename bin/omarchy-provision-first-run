#!/bin/bash

# omarchy:summary=Finish first-login setup for Maslow OS.
# omarchy:args=[--force]
# omarchy:hidden=true

set -e

usage() {
  cat <<USAGE
Usage: omarchy-provision-first-run [--force]

Run first-login user setup and notification hooks. By default this only runs
once per user. Use --force to rerun the full sequence and refresh user setup.
USAGE
}

force=0
finalize_user_args=()
while (($#)); do
  case "$1" in
    --force)
      force=1
      finalize_user_args+=(--force)
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

state_dir=~/.local/state/omarchy
FIRST_RUN_DONE="first-run-user"
if omarchy-done check "$FIRST_RUN_DONE" && (( force == 0 )); then
  echo "First-run already complete (rerun with --force to refresh)."
  exit 0
fi

mkdir -p "$state_dir"

FIRST_RUN_LOG="$state_dir/first-run.log"
MASLOW_STATE_DIR="$HOME/.local/state/maslow-os"
PENDING_FILE="$MASLOW_STATE_DIR/setup-pending"
OPTIONAL_FAILURE_FILE="$MASLOW_STATE_DIR/optional-failures"
first_run_core_failed=0
first_run_optional_failed=0

log_first_run() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$FIRST_RUN_LOG"
}

run_first_run_step() {
  local requirement="$1"
  shift
  local name="$1"
  shift

  log_first_run "Starting: $name"
  if "$@"; then
    log_first_run "Completed: $name"
  else
    local status=$?
    if [[ $requirement == "core" ]]; then
      first_run_core_failed=1
    else
      first_run_optional_failed=1
    fi
    log_first_run "Failed: $name (exit code: $status)"
  fi
}

if [[ -s $OPTIONAL_FAILURE_FILE ]]; then
  finalize_user_args+=(--force)
fi
rm -f "$OPTIONAL_FAILURE_FILE"
export MASLOW_OPTIONAL_FAILURE_FILE="$OPTIONAL_FAILURE_FILE"

run_first_run_step core "finalize user defaults" \
  omarchy-provision-user "${finalize_user_args[@]}"
if [[ -s $OPTIONAL_FAILURE_FILE ]]; then
  first_run_optional_failed=1
  while IFS= read -r failed_script; do
    [[ -n $failed_script ]] && log_first_run "Optional setup failed: $failed_script"
  done <"$OPTIONAL_FAILURE_FILE"
fi

run_first_run_step core "enable user systemd units" \
  bash "$OMARCHY_PATH/install/user/first-run/enable-user-units.sh"
run_first_run_step optional "set GNOME theme" \
  bash "$OMARCHY_PATH/install/user/first-run/gnome-theme.sh"
run_first_run_step optional "set GTK primary paste" \
  bash "$OMARCHY_PATH/install/user/first-run/gtk-primary-paste.sh"
run_first_run_step optional "apply speaker tuning" \
  bash "$OMARCHY_PATH/install/user/first-run/audio-tuning.sh"

omarchy-notification-wait || log_first_run "Timed out waiting for notification service; continuing"
# Each send returns only once the server has taken the toast, so sending in
# order is enough to stack them newest-on-top.
run_first_run_step optional "show welcome notification" \
  bash "$OMARCHY_PATH/install/user/first-run/welcome.sh"
run_first_run_step optional "schedule Wi-Fi/update notifications" \
  bash "$OMARCHY_PATH/install/user/first-run/wifi.sh"

if (( first_run_core_failed == 0 )); then
  run_first_run_step core "record first-run completion" omarchy-done mark "$FIRST_RUN_DONE"
fi

if (( first_run_core_failed == 0 )); then
  run_first_run_step optional "open Maslow AI setup" omarchy-setup-ai --first-login
  if (( first_run_optional_failed == 0 )); then
    rm -f "$PENDING_FILE"
  else
    mkdir -p "$MASLOW_STATE_DIR"
    printf 'Optional Maslow OS setup needs attention. See %s\n' "$FIRST_RUN_LOG" >"$PENDING_FILE"
    omarchy-notification-send "Finish Maslow OS setup" \
      "One or more optional setup steps can be retried." -u normal \
      --exec omarchy-launch-floating-terminal-with-presentation omarchy-setup-finish || true
  fi
else
  mkdir -p "$MASLOW_STATE_DIR"
  printf 'Core Maslow OS setup failed. See %s\n' "$FIRST_RUN_LOG" >"$PENDING_FILE"
  log_first_run "Core first-run setup failed; first-run will retry next login"
  omarchy-notification-send "Finish Maslow OS setup" \
    "A required setup step failed. Open the recovery flow for details." -u critical \
    --exec omarchy-launch-floating-terminal-with-presentation omarchy-setup-finish || true
  exit 1
fi
