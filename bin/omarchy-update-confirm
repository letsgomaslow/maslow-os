#!/bin/bash

# omarchy:summary=Confirm a Maslow OS update

maslow_releases=$(omarchy-branding-product links.releases)
engine_releases=$(omarchy-branding-product links.engineReleases)

gum style --border normal --padding "1 2" \
  "Maslow OS Update" \
  "" \
  "This can include Maslow presentation, the Omarchy engine, and system packages." \
  "• Do not stop the update once it starts" \
  "• Make sure you're connected to power or have a full battery" \
  "" \
  "Maslow OS release notes: $maslow_releases" \
  "Omarchy engine notes: $engine_releases"

echo

if ! gum confirm "Continue with Maslow OS Update?"; then
  echo "Maslow OS Update canceled"
  exit 1
fi
