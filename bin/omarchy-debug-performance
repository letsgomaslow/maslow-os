#!/bin/bash

# omarchy:summary=Capture a read-only Maslow OS performance baseline
# omarchy:args=[--json] [--settle=SECONDS] [--sample=SECONDS]
# omarchy:examples=omarchy debug performance | omarchy debug performance --json --settle=300 --sample=10

set -euo pipefail

json=false
settle_seconds=300
sample_seconds=10

usage() {
  echo "Usage: omarchy-debug-performance [--json] [--settle=SECONDS] [--sample=SECONDS]" >&2
}

valid_seconds() {
  [[ $1 =~ ^[0-9]+$ ]] && (( 10#$1 <= 3600 ))
}

while (( $# > 0 )); do
  case "$1" in
  --json) json=true ;;
  --settle=*) settle_seconds=${1#*=} ;;
  --sample=*) sample_seconds=${1#*=} ;;
  *) usage; exit 2 ;;
  esac
  shift
done

valid_seconds "$settle_seconds" || { echo "Settle time must be between 0 and 3600 seconds." >&2; exit 2; }
valid_seconds "$sample_seconds" && (( 10#$sample_seconds > 0 )) || { echo "Sample time must be between 1 and 3600 seconds." >&2; exit 2; }

[[ -r /proc/meminfo && -r /proc/stat ]] || {
  echo "This baseline requires Linux /proc memory and CPU statistics." >&2
  exit 1
}

if (( 10#$settle_seconds > 0 )); then
  echo "Waiting ${settle_seconds}s for the desktop to settle..." >&2
  sleep "$settle_seconds"
fi

read_cpu() {
  awk 'NR == 1 {
    idle = $5 + $6
    total = 0
    # guest and guest_nice are already included in user and nice.
    for (i = 2; i <= 9 && i <= NF; i++) total += $i
    print idle, total
    exit
  }' /proc/stat
}

read -r idle_before total_before < <(read_cpu)
sleep "$sample_seconds"
read -r idle_after total_after < <(read_cpu)

cpu_percent=$(awk -v idle_before="$idle_before" -v idle_after="$idle_after" -v total_before="$total_before" -v total_after="$total_after" 'BEGIN {
  idle_delta = idle_after - idle_before
  total_delta = total_after - total_before
  if (total_delta <= 0) print "null"
  else printf "%.2f", 100 * (total_delta - idle_delta) / total_delta
}')

read -r memory_total_kib memory_available_kib < <(awk '
  /^MemTotal:/ { total = $2 }
  /^MemAvailable:/ { available = $2 }
  END { print total, available }
' /proc/meminfo)
memory_used_kib=$((memory_total_kib - memory_available_kib))

collect_units() {
  local output
  if output=$(systemctl "$@" --no-legend --no-pager --plain 2>/dev/null); then
    printf '%s\n' "$output" | awk 'NF { print $1 }' | sort -u \
      | jq -Rsc '{available: true, names: (split("\n") | map(select(length > 0)))}'
  else
    printf '%s\n' '{"available":false,"names":[]}'
  fi
}

collect_processes() {
  local output
  # comm is the executable name, never argv. Keep it last to preserve spaces.
  if output=$(LC_ALL=C ps -e -o pid=,uid=,rss=,%cpu=,comm= 2>/dev/null); then
    printf '%s\n' "$output" | jq -Rsc '{available: true, processes: (
      split("\n") | map(select(test("\\S")) | capture("^\\s*(?<pid>[0-9]+)\\s+(?<uid>[0-9]+)\\s+(?<rssKiB>[0-9]+)\\s+(?<cpuPercent>[0-9.]+)\\s+(?<command>.+)$")
        | .pid |= tonumber | .uid |= tonumber | .rssKiB |= tonumber | .cpuPercent |= tonumber)
    )}'
  else
    printf '%s\n' '{"available":false,"processes":[]}'
  fi
}

enabled_user_units=$(collect_units --user list-unit-files --state=enabled)
running_user_services=$(collect_units --user list-units --type=service --state=running)
running_system_services=$(collect_units list-units --type=service --state=running)
process_snapshot=$(collect_processes)
services_json=$(jq '[.names[] | select(ascii_downcase | contains("maslow"))]' <<<"$enabled_user_units")
processes_json=$(jq --argjson uid "$UID" '[.processes[] | select(.uid == $uid and (.command | ascii_downcase | contains("maslow"))) | del(.uid)]' <<<"$process_snapshot")

captured_at=$(date --iso-8601=seconds)
result=$(jq -n \
  --arg capturedAt "$captured_at" \
  --arg host "$(uname -n)" \
  --argjson settleSeconds "$((10#$settle_seconds))" \
  --argjson sampleSeconds "$((10#$sample_seconds))" \
  --argjson cpuPercent "$cpu_percent" \
  --argjson memoryTotalKiB "$memory_total_kib" \
  --argjson memoryUsedKiB "$memory_used_kib" \
  --argjson services "$services_json" \
  --argjson processes "$processes_json" \
  --argjson enabledUserUnits "$enabled_user_units" \
  --argjson runningUserServices "$running_user_services" \
  --argjson runningSystemServices "$running_system_services" \
  --argjson processSnapshot "$process_snapshot" \
  '{
    schemaVersion: 1,
    purpose: "engineering-evidence",
    note: "Comparison evidence only; these values are not minimum system requirements.",
    capturedAt: $capturedAt,
    host: $host,
    settleSeconds: $settleSeconds,
    sampleSeconds: $sampleSeconds,
    idle: {
      cpuPercent: $cpuPercent,
      memoryUsedKiB: $memoryUsedKiB,
      memoryTotalKiB: $memoryTotalKiB
    },
    maslowNamedUserServices: $services,
    maslowNamedProcesses: $processes,
    enabledUserUnits: $enabledUserUnits,
    runningUserServices: $runningUserServices,
    runningSystemServices: $runningSystemServices,
    processSnapshot: $processSnapshot
  }')

if [[ $json == "true" ]]; then
  printf '%s\n' "$result"
else
  jq -r '
    "Maslow OS performance baseline (engineering evidence)",
    "Not a minimum system requirement.",
    "Captured: \(.capturedAt)",
    "Settled: \(.settleSeconds)s; CPU sample: \(.sampleSeconds)s",
    "Idle CPU: \(if .idle.cpuPercent == null then "unavailable" else (.idle.cpuPercent | tostring) + "%" end)",
    "Used RAM: \((.idle.memoryUsedKiB / 1024) | floor) MiB of \((.idle.memoryTotalKiB / 1024) | floor) MiB",
    "Running user services: \(if .runningUserServices.available then (.runningUserServices.names | join(", ")) else "unavailable" end)",
    "Running system services: \(if .runningSystemServices.available then (.runningSystemServices.names | join(", ")) else "unavailable" end)",
    "Largest processes by RSS (all users; CPU is lifetime average, not the sample window):",
    (if .processSnapshot.available then (.processSnapshot.processes | sort_by(-.rssKiB) | .[:10][] | "  \(.pid)  \(.command)  \(.rssKiB) KiB  \(.cpuPercent)% CPU") else "  unavailable" end),
    "Maslow-named enabled user services: \(if (.maslowNamedUserServices | length) == 0 then "none" else (.maslowNamedUserServices | join(", ")) end)",
    "Maslow-named processes:",
    (if (.maslowNamedProcesses | length) == 0 then "  none" else (.maslowNamedProcesses[] | "  \(.pid)  \(.command)  \(.rssKiB) KiB  \(.cpuPercent)% CPU") end)
  ' <<<"$result"
fi
