#!/bin/bash

# omarchy:summary=Install the Hermes desktop app
# omarchy:requires-sudo=true

set -e

if ! omarchy-pkg-available hermes-desktop; then
  echo "Hermes Desktop is not available for this system." >&2
  echo "You can use Hermes as a coding agent from Setup → AI." >&2
  exit 1
fi

# Desktop is optional and separate from the reviewed packaged Voice agent.
# Installing it must not retire, rewrite or bootstrap any CLI runtime.
echo "Installing Hermes Desktop..."
omarchy-pkg-add hermes-desktop

echo "Opening Hermes Desktop..."
setsid uwsm-app -- /usr/bin/hermes-desktop >/dev/null 2>&1 &

echo ""
echo "Hermes Desktop has been installed."
echo "Desktop manages its own setup; the packaged Hermes agent is kept."
