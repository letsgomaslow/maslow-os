#!/bin/bash

# omarchy:summary=Reinstall all default Omarchy packages from the stable channel, or on aarch64 the edge channel
# omarchy:requires-sudo=true

set -e

# Reinstall all default Omarchy packages from the platform's default channel
# (stable, or edge on aarch64) and downgrade any packages that are too new.

# Set the package repository to the platform's default channel
omarchy-refresh-pacman

# The default channel still must not replace Maslow's held runtime.
runtime_hold_args=()
while IFS= read -r arg; do
  runtime_hold_args+=("$arg")
done < <(omarchy-update-runtime-guard pacman-args)
omarchy-update-pacman -Suu --noconfirm "${runtime_hold_args[@]}"

# Compose the platform's defaults, then exclude held runtime packages.
default_packages=$(omarchy-pkg-defaults)
mapfile -t packages <<<"$default_packages"
filtered_packages=()
while IFS= read -r package; do
  filtered_packages+=("$package")
done < <(omarchy-update-runtime-guard filter-packages "${packages[@]}")
packages=("${filtered_packages[@]}")
omarchy-update-pacman -Syu --noconfirm --needed "${runtime_hold_args[@]}" "${packages[@]}"
