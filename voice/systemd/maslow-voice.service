[Unit]
Description=Maslow Voice conversational coordinator
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/lib/maslow-voice/venv/bin/python -I -S -B -X pycache_prefix=/dev/null /usr/lib/maslow-voice/bootstrap.py daemon
UnsetEnvironment=PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONUSERBASE PYTHONPYCACHEPREFIX LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=graphical-session.target
