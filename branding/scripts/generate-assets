#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
MAGICK=${MAGICK:-magick}
MARK_GRADIENT="$ROOT/branding/logos/maslow-mark-gradient.svg"
MARK_DARK="$ROOT/branding/logos/maslow-mark-dark.svg"
FONT="$ROOT/branding/fonts/manrope/Manrope-VariableFont_wght.ttf"
PRODUCT_MANIFEST="$ROOT/branding/product.json"
WALLPAPER_COLLAGE="$ROOT/branding/wallpapers/maslow-wallpaper-collage.png"
WALLPAPER_SOURCE_DIR="$ROOT/branding/wallpapers"
TERMINAL_ART_DIR=$(mktemp -d)
TERMINAL_SOURCE_DIR="$ROOT/branding/terminal"
render_wallpaper_assets=false

if [[ ${1:-} == "--wallpapers" ]]; then
  render_wallpaper_assets=true
elif (( $# > 0 )); then
  echo "Usage: branding/scripts/generate-assets [--wallpapers]" >&2
  exit 2
fi

export LC_ALL=C.UTF-8
trap 'rm -rf "$TERMINAL_ART_DIR"' EXIT

command -v "$MAGICK" >/dev/null || {
  echo "ImageMagick is required (expected the 'magick' command)." >&2
  exit 1
}

for source in \
  "$MARK_GRADIENT" "$MARK_DARK" "$FONT" "$PRODUCT_MANIFEST" \
  "$TERMINAL_SOURCE_DIR/logo.txt" "$TERMINAL_SOURCE_DIR/icon.txt"; do
  [[ -f $source ]] || {
    echo "Missing brand source: $source" >&2
    exit 1
  }
done

PRODUCT_NAME=$(jq -er '.product.name' "$PRODUCT_MANIFEST")
[[ $PRODUCT_NAME == "Maslow AI-OS" ]] || {
  echo "Unexpected product name: $PRODUCT_NAME" >&2
  exit 1
}

if [[ $render_wallpaper_assets == "true" ]]; then
  for source in \
    "$WALLPAPER_COLLAGE" \
    "$WALLPAPER_SOURCE_DIR/05-gradient-bridge-quiet-field.webp" \
    "$WALLPAPER_SOURCE_DIR/06-signal-over-water.webp" \
    "$WALLPAPER_SOURCE_DIR/07-topographic-ascent.webp"; do
    [[ -f $source ]] || {
      echo "Missing brand source: $source" >&2
      exit 1
    }
  done
fi

render_wallpapers() {
  local dark_output="$ROOT/themes/maslow-dark/backgrounds"
  local light_output="$ROOT/themes/maslow-light/backgrounds"
  local index name crop
  local -a names=(
    01-mountain-sunrise.webp
    02-canyon-storm.webp
    03-aurora-lake.webp
    04-spiral-galaxy.webp
  )
  local -a crops=(
    1371x763+0+0
    1371x763+1381+0
    1371x763+0+773
    1371x763+1381+773
  )
  local -a logo_free_names=(
    05-gradient-bridge-quiet-field.webp
    06-signal-over-water.webp
    07-topographic-ascent.webp
  )

  mkdir -p "$dark_output" "$light_output"
  rm -f \
    "$dark_output/bridge.webp" "$dark_output/pathways.webp" \
    "$light_output/bridge.webp" "$light_output/pathways.webp"

  for index in "${!names[@]}"; do
    name=${names[$index]}
    crop=${crops[$index]}
    "$MAGICK" "$WALLPAPER_COLLAGE" \
      -crop "$crop" +repage \
      -filter Lanczos -resize '3840x2160^' -gravity center -extent 3840x2160 \
      -strip -quality 94 "$dark_output/$name"
    cp "$dark_output/$name" "$light_output/$name"
  done

  for name in "${logo_free_names[@]}"; do
    "$MAGICK" "$WALLPAPER_SOURCE_DIR/$name" \
      -filter Lanczos -resize '3840x2160^' -gravity center -extent 3840x2160 \
      -strip -quality 94 "$dark_output/$name"
    cp "$dark_output/$name" "$light_output/$name"
  done

  "$MAGICK" "$dark_output/${names[0]}" -resize 1200x675^ -gravity center -extent 1200x675 -strip "$ROOT/themes/maslow-dark/preview.png"
  cp "$ROOT/themes/maslow-dark/preview.png" "$ROOT/themes/maslow-light/preview.png"
}

render_lockup() {
  local text_color=$1 output=$2 scale=${3:-100}
  local canvas_width=$((800 * scale / 100))
  local canvas_height=$((188 * scale / 100))
  local mark_width=$((176 * scale / 100))
  local mark_height=$((118 * scale / 100))
  local mark_gap=$((24 * scale / 100))
  local wordmark_gap=$((8 * scale / 100))
  local text_height=$((94 * scale / 100))
  local maslow_width=$((270 * scale / 100))
  local tag_width=$((194 * scale / 100))
  local font_size=$((64 * scale / 100))
  local stroke_width=$((scale >= 150 ? 2 : 1))

  "$MAGICK" -background none "$MARK_GRADIENT" -trim +repage \
    -resize "${mark_width}x${mark_height}" "$TERMINAL_ART_DIR/lockup-mark.png"
  "$MAGICK" -size "${maslow_width}x${text_height}" xc:none \
    -font "$FONT" -weight 600 -pointsize "$font_size" \
    -fill "$text_color" -stroke "$text_color" -strokewidth "$stroke_width" -gravity center \
    -annotate +0+0 'MASLOW' "$TERMINAL_ART_DIR/lockup-maslow.png"
  "$MAGICK" -size "${tag_width}x${text_height}" xc:none \
    -font "$FONT" -weight 600 -pointsize "$font_size" \
    -fill '#C1C1C1' -stroke '#C1C1C1' -strokewidth "$stroke_width" -gravity center \
    -annotate +0+0 '| AI-OS' "$TERMINAL_ART_DIR/lockup-ai-os.png"

  "$MAGICK" \
    "$TERMINAL_ART_DIR/lockup-mark.png" \( -size "${mark_gap}x1" xc:none \) \
    "$TERMINAL_ART_DIR/lockup-maslow.png" \( -size "${wordmark_gap}x1" xc:none \) \
    "$TERMINAL_ART_DIR/lockup-ai-os.png" \
    -background none -gravity center +append -trim +repage -gravity center \
    -extent "${canvas_width}x${canvas_height}" -depth 8 "$output"
}

render_terminal_logo() {
  cp "$TERMINAL_SOURCE_DIR/logo.txt" "$ROOT/logo.txt"
}

render_terminal_icon() {
  cp "$TERMINAL_SOURCE_DIR/icon.txt" "$ROOT/icon.txt"
}

if [[ $render_wallpaper_assets == "true" ]]; then
  render_wallpapers
fi

render_lockup "#FFFFFF" "$ROOT/themes/maslow-dark/unlock.png"
render_lockup "#121D35" "$ROOT/themes/maslow-light/unlock.png"
render_lockup "#FFFFFF" "$ROOT/default/plymouth/logo.png" 150
cp "$ROOT/default/plymouth/logo.png" "$ROOT/default/sddm/omarchy/logo.png"
render_terminal_logo
render_terminal_icon

"$MAGICK" -size 1200x675 xc:"#121D35" "$ROOT/themes/maslow-dark/unlock.png" -gravity center -composite -depth 8 "$ROOT/themes/maslow-dark/preview-unlock.png"
"$MAGICK" -size 1200x675 xc:"#FFFFFF" "$ROOT/themes/maslow-light/unlock.png" -gravity center -composite -depth 8 "$ROOT/themes/maslow-light/preview-unlock.png"
"$MAGICK" -size 1920x1080 xc:"#121D35" "$ROOT/default/plymouth/logo.png" -gravity center -composite -depth 8 "$ROOT/default/plymouth/preview-unlock.png"

"$MAGICK" -size 300x300 xc:none \( -background none "$MARK_GRADIENT" -resize 270x190 \) -gravity center -composite -depth 8 "$ROOT/icon.png"
"$MAGICK" -size 800x378 xc:none \( -background none "$MARK_GRADIENT" -resize 520x346 \) -gravity center -composite -depth 8 "$ROOT/default/plymouth/logos/oma.png"

"$MAGICK" -size 286x48 xc:none -fill "#1A2948" -stroke "#6DC4AD" -strokewidth 2 -draw "roundrectangle 1,1 284,46 8,8" -depth 8 "$ROOT/default/plymouth/entry.png"
"$MAGICK" -size 286x48 xc:none -fill "#1A2948" -stroke "#FF7A90" -strokewidth 2 -draw "roundrectangle 1,1 284,46 8,8" -depth 8 "$ROOT/default/sddm/omarchy/entry-failed.png"
cp "$ROOT/default/plymouth/entry.png" "$ROOT/default/sddm/omarchy/entry.png"

"$MAGICK" -size 14x14 xc:none -fill "#6DC4AD" -draw "circle 7,7 7,1" -depth 8 "$ROOT/default/plymouth/bullet.png"
cp "$ROOT/default/plymouth/bullet.png" "$ROOT/default/sddm/omarchy/bullet.png"

"$MAGICK" -size 84x96 xc:none -fill none -stroke "#D9DEE8" -strokewidth 7 \
  -draw "roundrectangle 18,40 66,86 7,7" -draw "path 'M 28,40 L 28,30 C 28,12 56,12 56,30 L 56,40'" -depth 8 "$ROOT/default/plymouth/lock.png"
"$MAGICK" -size 84x96 xc:none -fill none -stroke "#FF7A90" -strokewidth 7 \
  -draw "roundrectangle 18,40 66,86 7,7" -draw "path 'M 28,40 L 28,30 C 28,12 56,12 56,30 L 56,40'" -depth 8 "$ROOT/default/sddm/omarchy/lock-failed.png"
cp "$ROOT/default/plymouth/lock.png" "$ROOT/default/sddm/omarchy/lock.png"

"$MAGICK" -size 300x10 xc:"#24324D" -depth 8 "$ROOT/default/plymouth/progress_box.png"
"$MAGICK" -size 300x10 xc:"#6DC4AD" -depth 8 "$ROOT/default/plymouth/progress_bar.png"

echo "$PRODUCT_NAME assets generated."
