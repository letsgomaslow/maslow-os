{
  "$schema": "https://maslow.ai/schemas/brand-tokens.schema.json",
  "name": "maslow-brand-system",
  "version": "2026.05.27",
  "color": {
    "brand": {
      "teal": "#6DC4AD",
      "tealAccessible": "#247967",
      "pink": "#EE7BB3",
      "pinkAccessible": "#A92F73",
      "purpleDeep": "#401877",
      "purpleLight": "#A070A6",
      "orange": "#F2A23A",
      "orangeAccessible": "#9C5A00",
      "darkNavy": "#121D35"
    },
    "text": {
      "primary": "#333333",
      "secondary": "#666666",
      "inverse": "#FFFFFF",
      "onAccent": "#333333",
      "onDark": "#FFFFFF"
    },
    "surface": {
      "default": "#FFFFFF",
      "soft": "#F6F7F9",
      "muted": "#EDEFF3",
      "dark": "#121D35",
      "darkRaised": "#1A2948"
    },
    "border": {
      "subtle": "#D9DEE8",
      "strong": "#8C95A8"
    },
    "focus": {
      "ring": "#247967",
      "ringOnDark": "#6DC4AD"
    },
    "service": {
      "strategy": "{color.brand.pink}",
      "technology": "{color.brand.teal}",
      "design": "{color.brand.purpleDeep}"
    }
  },
  "typography": {
    "fontFamily": {
      "primary": "Manrope, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "optionalMetadata": "Formular, Manrope, system-ui, sans-serif",
      "optionalLogoAI": "FoundersGroteskMono, ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": {
      "display": { "fontSize": "60px", "lineHeight": "62px", "fontWeight": 600 },
      "section": { "fontSize": "38px", "lineHeight": "42px", "fontWeight": 600 },
      "heading": { "fontSize": "32px", "lineHeight": "40px", "fontWeight": 500 },
      "cardTitle": { "fontSize": "24px", "lineHeight": "30px", "fontWeight": 700 },
      "lead": { "fontSize": "18px", "lineHeight": "30px", "fontWeight": 400 },
      "body": { "fontSize": "17px", "lineHeight": "27px", "fontWeight": 400 },
      "small": { "fontSize": "15px", "lineHeight": "24px", "fontWeight": 400 },
      "label": { "fontSize": "12px", "lineHeight": "16px", "fontWeight": 600 },
      "micro": { "fontSize": "9px", "lineHeight": "13px", "fontWeight": 700 }
    }
  },
  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px",
    "32": "128px"
  },
  "radius": {
    "sm": "2px",
    "md": "4px",
    "lg": "8px",
    "xl": "17px",
    "2xl": "34px",
    "full": "9999px"
  },
  "shadow": {
    "card": "17px 9px 5px rgba(0, 0, 0, 0.25)",
    "soft": "2px 2px 10px rgba(0, 0, 0, 0.10)",
    "headshot": "0 4px 6px rgba(0, 0, 0, 0.124)"
  },
  "layout": {
    "canvasMax": "1400px",
    "contentMax": "1200px",
    "narrowMax": "1002px",
    "gridColumns": 12,
    "gridGutter": "24px",
    "desktopMarginAtCanvas": "100px",
    "mobileMarginMin": "20px",
    "mobileMarginMax": "24px"
  },
  "contrastPairs": [
    {
      "name": "primary text on default surface",
      "foreground": "{color.text.primary}",
      "background": "{color.surface.default}",
      "minimum": 4.5
    },
    {
      "name": "secondary text on default surface",
      "foreground": "{color.text.secondary}",
      "background": "{color.surface.default}",
      "minimum": 4.5
    },
    {
      "name": "inverse text on dark navy",
      "foreground": "{color.text.inverse}",
      "background": "{color.brand.darkNavy}",
      "minimum": 4.5
    },
    {
      "name": "dark text on pink CTA",
      "foreground": "{color.text.onAccent}",
      "background": "{color.brand.pink}",
      "minimum": 4.5
    },
    {
      "name": "dark text on teal CTA",
      "foreground": "{color.text.onAccent}",
      "background": "{color.brand.teal}",
      "minimum": 4.5
    },
    {
      "name": "pink accessible on white",
      "foreground": "{color.brand.pinkAccessible}",
      "background": "{color.surface.default}",
      "minimum": 4.5
    },
    {
      "name": "teal accessible on white",
      "foreground": "{color.brand.tealAccessible}",
      "background": "{color.surface.default}",
      "minimum": 4.5
    },
    {
      "name": "purple deep on white",
      "foreground": "{color.brand.purpleDeep}",
      "background": "{color.surface.default}",
      "minimum": 4.5
    },
    {
      "name": "focus ring on white",
      "foreground": "{color.focus.ring}",
      "background": "{color.surface.default}",
      "minimum": 3
    },
    {
      "name": "focus ring on dark",
      "foreground": "{color.focus.ringOnDark}",
      "background": "{color.surface.dark}",
      "minimum": 3
    }
  ],
  "legacyConflicts": {
    "forbiddenCanonicalFonts": ["Graphik"],
    "forbiddenCtaPairings": [
      "white text on pink fill",
      "white text on teal fill"
    ],
    "serviceColorMap": {
      "strategy": "pink",
      "technology": "teal",
      "design": "purple"
    }
  }
}
