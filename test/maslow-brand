#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

fail() {
  echo "not ok - $1" >&2
  exit 1
}

pass() {
  echo "ok - $1"
}

require_file() {
  [[ -f $ROOT/$1 ]] || fail "missing $1"
}

assert_contains() {
  local file=$1 pattern=$2 description=$3
  grep -Fq "$pattern" "$ROOT/$file" || fail "$description"
  pass "$description"
}

for file in \
  maslow-version NOTICE DOWNSTREAM.md branding/design-tokens.json branding/product.json \
  branding/logos/maslow-mark-gradient.svg branding/logos/maslow-mark-dark.svg \
  branding/fonts/manrope/Manrope-VariableFont_wght.ttf branding/fonts/manrope/OFL.txt \
  branding/terminal/logo.txt branding/terminal/icon.txt \
  branding/wallpapers/maslow-wallpaper-collage.png \
  branding/wallpapers/05-gradient-bridge-quiet-field.webp \
  branding/wallpapers/06-signal-over-water.webp \
  branding/wallpapers/07-topographic-ascent.webp \
  branding/scripts/generate-assets branding/scripts/generate-brand-preview logo.txt icon.txt icon.png \
  default/plymouth/omarchy.plymouth default/plymouth/omarchy.script default/plymouth/logo.png \
  default/sddm/omarchy/metadata.desktop default/sddm/omarchy/Main.qml default/sddm/omarchy/logo.png \
  install/user/first-run/welcome.sh default/omarchy/omarchy-menu.jsonc etc/fastfetch/config.jsonc \
  themes/maslow-dark/colors.toml themes/maslow-dark/hyprland.lua \
  themes/maslow-light/colors.toml themes/maslow-light/hyprland.lua \
  default/hypr/toggles/reduced-motion.lua; do
  require_file "$file"
done
pass "required Maslow OS sources exist"

manifest_version=$(jq -r '.product.version' "$ROOT/branding/product.json")
[[ $(<"$ROOT/maslow-version") == "$manifest_version" ]] || fail "Maslow OS version differs from the product manifest"
pass "Maslow OS version is pinned"

assert_contains README.md "Maslow OS is based on" "README preserves Omarchy attribution"
assert_contains install/provisioning/setup-form.sh "OMARCHY_HOSTNAME_DEFAULT='maslow-os'" "setup defaults to a Maslow OS hostname"
assert_contains install/provisioning/setup-form.sh "return for 'maslow-os'" "setup hostname hint uses Maslow OS"
assert_contains branding/scripts/generate-assets "'.product.name'" "asset generator consumes the canonical product name"
assert_contains branding/scripts/generate-assets '[[ $PRODUCT_NAME == "Maslow AI-OS" ]]' "asset generator validates the Maslow AI-OS product name"
assert_contains branding/scripts/generate-assets 'branding/logos/maslow-mark-gradient.svg' "asset generator consumes the canonical gradient mark"
assert_contains branding/scripts/generate-assets 'branding/logos/maslow-mark-dark.svg' "asset generator consumes the canonical dark mark"
assert_contains branding/scripts/generate-assets 'branding/fonts/manrope/Manrope-VariableFont_wght.ttf' "asset generator consumes the canonical brand font"
assert_contains branding/scripts/generate-assets 'cp "$TERMINAL_SOURCE_DIR/logo.txt" "$ROOT/logo.txt"' "asset generator installs the canonical terminal lockup"
assert_contains branding/scripts/generate-assets 'cp "$TERMINAL_SOURCE_DIR/icon.txt" "$ROOT/icon.txt"' "asset generator installs the canonical About lockup"
assert_contains branding/scripts/generate-assets '"$ROOT/default/plymouth/logo.png"' "asset generator writes the Plymouth lockup"
assert_contains branding/scripts/generate-assets 'cp "$ROOT/default/plymouth/logo.png" "$ROOT/default/sddm/omarchy/logo.png"' "login and boot lockups share one generated source"
bash -n "$ROOT/branding/scripts/generate-brand-preview" || fail "brand preview generator has invalid shell syntax"
pass "brand preview generator has valid shell syntax"
assert_contains branding/scripts/generate-brand-preview 'branding/logos/maslow-mark-gradient.svg' "brand preview consumes the approved Gradient Bridge mark"
assert_contains branding/scripts/generate-brand-preview 'PRODUCT_LABEL="MASLOW | AI-OS"' "brand preview uses the proposed Maslow AI-OS lockup"
assert_contains branding/scripts/generate-brand-preview '"$OUTPUT_DIR/logo.txt"' "brand preview isolates the terminal candidate in its output directory"
assert_contains branding/scripts/generate-brand-preview '"$OUTPUT_DIR/icon.txt"' "brand preview isolates the About candidate in its output directory"
assert_contains branding/scripts/generate-brand-preview 'validate_width "$OUTPUT_DIR/logo.txt" "$TERMINAL_WIDTH"' "brand preview enforces the 100-column terminal contract"
assert_contains branding/design-tokens.json '"voiceBlueDeep": "#154BA8"' "voice orb deep blue is a canonical brand token"
assert_contains branding/design-tokens.json '"voiceBlue": "#2875E5"' "voice orb blue is a canonical brand token"
assert_contains branding/design-tokens.json '"voiceBlueLight": "#93C9FF"' "voice orb light blue is a canonical brand token"
assert_contains branding/design-tokens.json '"voiceCloud": "#EFF8FF"' "voice orb cloud white is a canonical brand token"
if "$ROOT/branding/scripts/generate-brand-preview" "$ROOT" >/dev/null 2>&1; then
  fail "brand preview generator accepts a shipping-tree output directory"
fi
pass "brand preview generator refuses shipping-tree output directories"
preview_guard_dir=$(mktemp -d)
touch "$preview_guard_dir/owner-file"
if "$ROOT/branding/scripts/generate-brand-preview" "$preview_guard_dir" >/dev/null 2>&1; then
  fail "brand preview generator overwrites an unmarked non-empty directory"
fi
rm -rf "$preview_guard_dir"
pass "brand preview generator refuses unmarked non-empty output directories"
assert_contains migrations/1788337736.sh "maslow-login-branding.hook" "updates preserve the Maslow login default"
assert_contains migrations/1788365928.sh "maslow-login-branding.hook" "existing installations immediately register branding repair"
assert_contains migrations/1788395901.sh "Label existing Limine boot entries as Maslow OS" "existing installations repair their visible boot entry"
assert_contains install/user/maslow-login-branding.sh "omarchy-hook-install post-update" "fresh installations register branding repair"
assert_contains bin/omarchy-migrate-notify "Pending Maslow OS Migrations" "migration notice uses Maslow OS"
assert_contains default/hypr/bindings/utilities.lua '"Maslow OS menu"' "keybinding hint uses Maslow OS"
assert_contains shell/plugins/menu/manifest.json '"name": "Maslow OS menu"' "shell menu metadata uses Maslow OS"
assert_contains shell/plugins/bar/widgets/SystemUpdate.manifest.json '"name": "Maslow OS update"' "update widget metadata uses Maslow OS"
assert_contains shell/plugins/menu/BarWidget.qml 'text: "\ue90b"' "top-left menu uses the approved Maslow glyph"

logo_dimensions=$(python3 - "$ROOT/logo.txt" <<'PY'
from pathlib import Path
import sys

lines = Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()
print(max((len(line) for line in lines), default=0), len(lines))
PY
)
read -r logo_width logo_height <<<"$logo_dimensions"
(( logo_width <= 100 )) || fail "setup logo exceeds the 100-column console contract"
(( logo_height == 9 )) || fail "setup logo is not the approved nine-row terminal lockup"
grep -q '[█▀▄]' "$ROOT/logo.txt" || fail "setup logo is not block artwork"
grep -Fq 'MASLOW | AI-OS' "$ROOT/icon.txt" || fail "About logo does not identify Maslow AI-OS"
cmp -s "$ROOT/branding/terminal/logo.txt" "$ROOT/logo.txt" || fail "setup logo differs from its approved source"
cmp -s "$ROOT/branding/terminal/icon.txt" "$ROOT/icon.txt" || fail "About logo differs from its approved source"
pass "setup and About use terminal-safe Maslow Gradient Bridge lockups"
assert_contains install/user/theme.sh 'omarchy-theme-set "Maslow Dark"' "Maslow Dark is the installation default"
assert_contains default/plymouth/omarchy.plymouth 'Name=Maslow AI-OS' "Plymouth metadata identifies Maslow AI-OS"
assert_contains default/plymouth/omarchy.plymouth 'Description=Maslow AI-OS splash screen.' "Plymouth description identifies Maslow AI-OS"
assert_contains default/sddm/omarchy/metadata.desktop 'Name=Maslow AI-OS' "login theme metadata identifies Maslow AI-OS"
assert_contains default/sddm/omarchy/Main.qml 'Welcome to Maslow AI-OS.' "login greeting identifies Maslow AI-OS"
assert_contains install/user/first-run/welcome.sh 'Maslow OS Menu' "first session welcome identifies the Maslow OS menu"
assert_contains default/omarchy/omarchy-menu.jsonc '"label":"About Maslow AI-OS"' "menu identifies the Maslow AI-OS About entry"
assert_contains default/omarchy/omarchy-menu.jsonc '"label":"Maslow AI-OS Guide"' "menu identifies the Maslow AI-OS guide entry"
assert_contains default/omarchy/omarchy-menu.jsonc '"label":"Reduced Motion"' "Reduced Motion is visible in the menu"
assert_contains default/omarchy/omarchy-menu.jsonc 'omarchy-hyprland-toggle reduced-motion' "Reduced Motion uses the persistent Hyprland toggle"
assert_contains bin/omarchy-theme-set 'background setInstant' "Reduced Motion uses instant background application"
assert_contains etc/fastfetch/config.jsonc 'omarchy-branding-product product.name' "About consumes canonical product metadata"
assert_contains etc/fastfetch/config.jsonc 'omarchy-branding-product attribution.short' "About preserves Omarchy engine attribution"
assert_contains default/fonts/omarchy/README.md 'U+E90B` — Maslow OS' "Maslow mark uses additive private glyph U+E90B"
assert_contains default/fonts/omarchy/README.md 'U+E900` — Omarchy' "Omarchy compatibility glyph remains U+E900"
assert_contains default/sddm/omarchy/Main.qml 'Accessible.name' "login screen provides accessible names"
assert_contains default/sddm/omarchy/Main.qml 'Accessible.AlertMessage' "login screen exposes live status alerts"
assert_contains default/sddm/omarchy/Main.qml 'Qt.Key_F5' "login screen provides spoken-login toggle"
assert_contains default/sddm/omarchy/Main.qml 'import QtQuick.Controls as QQC2' "login screen isolates Qt Quick Controls from SDDM component names"
assert_contains default/sddm/omarchy/Main.qml 'QQC2.Button {' "login button uses the Qt Quick Controls implementation"
assert_contains etc/limine-entry-tool.d/omarchy-defaults.conf 'TARGET_OS_NAME="Maslow OS"' "boot entries identify Maslow OS"
assert_contains install/user/first-run/wifi.sh '"Maslow OS Update" "Click to update Maslow OS."' "first-login update notice identifies Maslow OS"
assert_contains shell/plugins/maslow-ai-setup/manifest.json '"id": "maslow.ai-setup"' "guided AI setup uses stable first-party plugin ID"
assert_contains bin/omarchy-agent-trust 'disclosure_version=1' "agent permission disclosure is versioned"
assert_contains DOWNSTREAM.md '/usr/bin/omarchy*' "Omarchy command compatibility is documented"

wallpaper_names=(
  01-mountain-sunrise.webp
  02-canyon-storm.webp
  03-aurora-lake.webp
  04-spiral-galaxy.webp
  05-gradient-bridge-quiet-field.webp
  06-signal-over-water.webp
  07-topographic-ascent.webp
)
for theme in maslow-dark maslow-light; do
  for file in "${wallpaper_names[@]}"; do
    require_file "themes/$theme/backgrounds/$file"
  done
  for file in preview.png preview-unlock.png unlock.png icons.theme; do
    require_file "themes/$theme/$file"
  done
  background_count=$(find "$ROOT/themes/$theme/backgrounds" -maxdepth 1 -type f -name '*.webp' | wc -l)
  (( background_count == 7 )) || fail "$theme does not contain exactly seven WebP wallpapers"
done
for file in "${wallpaper_names[@]}"; do
  cmp -s "$ROOT/themes/maslow-dark/backgrounds/$file" "$ROOT/themes/maslow-light/backgrounds/$file" || fail "$file differs between Maslow Dark and Maslow Light"
done
pass "both themes include the same seven curated wallpapers"

for shared_asset in logo.png entry.png bullet.png lock.png; do
  cmp -s "$ROOT/default/plymouth/$shared_asset" "$ROOT/default/sddm/omarchy/$shared_asset" || fail "generated boot and login $shared_asset assets differ"
done
pass "boot and login retain their shared generated brand assets"

python3 - "$ROOT" <<'PY'
import pathlib
import re
import struct
import sys
import zlib

root = pathlib.Path(sys.argv[1])

def fail(message):
    raise SystemExit(f"not ok - {message}")

def palette(path):
    values = {}
    for line in path.read_text().splitlines():
        match = re.match(r'^([a-z_]+)\s*=\s*"(#[0-9A-Fa-f]{6})"$', line)
        if match:
            values[match.group(1)] = match.group(2)
    return values

def channel(value):
    value /= 255
    return value / 12.92 if value <= 0.04045 else ((value + 0.055) / 1.055) ** 2.4

def luminance(color):
    raw = bytes.fromhex(color[1:])
    return 0.2126 * channel(raw[0]) + 0.7152 * channel(raw[1]) + 0.0722 * channel(raw[2])

def contrast(a, b):
    high, low = sorted((luminance(a), luminance(b)), reverse=True)
    return (high + 0.05) / (low + 0.05)

dark = palette(root / "themes/maslow-dark/colors.toml")
light = palette(root / "themes/maslow-light/colors.toml")
expected = [
    (dark, "foreground", "background"),
    (dark, "muted", "background"),
    (dark, "accent", "background"),
    (dark, "magenta", "background"),
    (light, "foreground", "background"),
    (light, "muted", "background"),
    (light, "accent", "background"),
    (light, "magenta", "background"),
    (light, "orange", "background"),
]
for values, foreground, background in expected:
    ratio = contrast(values[foreground], values[background])
    if ratio < 4.5:
        fail(f"contrast {foreground}/{background} is {ratio:.2f}:1")
print("ok - theme text colors meet WCAG AA contrast")

def png_info(path):
    data = path.read_bytes()
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        fail(f"{path.relative_to(root)} is not a PNG")
    length = struct.unpack(">I", data[8:12])[0]
    if data[12:16] != b"IHDR" or length != 13:
        fail(f"{path.relative_to(root)} has no valid IHDR")
    width, height, depth, color_type = struct.unpack(">IIBB", data[16:26])
    return width, height, depth, color_type

def png_alpha_bounds(path):
    data = path.read_bytes()
    width, height, depth, color_type = png_info(path)
    if depth != 8 or color_type != 6:
        return False
    chunks = []
    offset = 8
    while offset < len(data):
        length = struct.unpack(">I", data[offset:offset + 4])[0]
        kind = data[offset + 4:offset + 8]
        payload = data[offset + 8:offset + 8 + length]
        if kind == b"IDAT":
            chunks.append(payload)
        offset += 12 + length
        if kind == b"IEND":
            break
    raw = zlib.decompress(b"".join(chunks))
    stride = width * 4
    previous = bytearray(stride)
    cursor = 0
    has_clear = False
    has_visible = False
    min_x = width
    min_y = height
    max_x = 0
    max_y = 0
    for y in range(height):
        filter_type = raw[cursor]
        cursor += 1
        row = bytearray(raw[cursor:cursor + stride])
        cursor += stride
        for index in range(stride):
            left = row[index - 4] if index >= 4 else 0
            up = previous[index]
            upper_left = previous[index - 4] if index >= 4 else 0
            if filter_type == 1:
                row[index] = (row[index] + left) & 0xFF
            elif filter_type == 2:
                row[index] = (row[index] + up) & 0xFF
            elif filter_type == 3:
                row[index] = (row[index] + ((left + up) // 2)) & 0xFF
            elif filter_type == 4:
                estimate = left + up - upper_left
                pa, pb, pc = abs(estimate - left), abs(estimate - up), abs(estimate - upper_left)
                predictor = left if pa <= pb and pa <= pc else up if pb <= pc else upper_left
                row[index] = (row[index] + predictor) & 0xFF
            elif filter_type != 0:
                fail(f"unsupported PNG filter in {path.relative_to(root)}")
        alphas = row[3::4]
        has_clear = has_clear or any(alpha < 255 for alpha in alphas)
        has_visible = has_visible or any(alpha > 0 for alpha in alphas)
        for x, alpha in enumerate(alphas):
            if alpha > 0:
                min_x = min(min_x, x)
                min_y = min(min_y, y)
                max_x = max(max_x, x + 1)
                max_y = max(max_y, y + 1)
        previous = row
    return has_clear, has_visible, (min_x, min_y, max_x, max_y)

def png_has_transparent_pixel(path):
    has_clear, has_visible, _ = png_alpha_bounds(path)
    return has_clear and has_visible

def webp_size(path):
    data = path.read_bytes()
    if data[:4] != b"RIFF" or data[8:12] != b"WEBP":
        fail(f"{path.relative_to(root)} is not WebP")
    kind = data[12:16]
    if kind == b"VP8X":
        return 1 + int.from_bytes(data[24:27], "little"), 1 + int.from_bytes(data[27:30], "little")
    if kind == b"VP8 ":
        return struct.unpack("<H", data[26:28])[0] & 0x3FFF, struct.unpack("<H", data[28:30])[0] & 0x3FFF
    if kind == b"VP8L":
        bits = int.from_bytes(data[21:25], "little")
        return (bits & 0x3FFF) + 1, ((bits >> 14) & 0x3FFF) + 1
    fail(f"unsupported WebP chunk in {path.relative_to(root)}")

if png_info(root / "branding/wallpapers/maslow-wallpaper-collage.png")[:2] != (2752, 1536):
    fail("wallpaper collage source is not 2752x1536")

wallpapers = (
    "01-mountain-sunrise.webp",
    "02-canyon-storm.webp",
    "03-aurora-lake.webp",
    "04-spiral-galaxy.webp",
    "05-gradient-bridge-quiet-field.webp",
    "06-signal-over-water.webp",
    "07-topographic-ascent.webp",
)
for theme in ("maslow-dark", "maslow-light"):
    for name in wallpapers:
        size = webp_size(root / "themes" / theme / "backgrounds" / name)
        if size != (3840, 2160):
            fail(f"{theme}/{name} is {size}, expected 3840x2160")
    for name in ("preview.png", "preview-unlock.png"):
        size = png_info(root / "themes" / theme / name)[:2]
        if size != (1200, 675):
            fail(f"{theme}/{name} is {size}, expected 1200x675")
    unlock = png_info(root / "themes" / theme / "unlock.png")
    if unlock[3] not in (4, 6):
        fail(f"{theme}/unlock.png has no alpha channel")
    if not png_has_transparent_pixel(root / "themes" / theme / "unlock.png"):
        fail(f"{theme}/unlock.png does not contain both transparent and visible pixels")
print("ok - generated theme assets meet dimensions and alpha contracts")

for relative in ("icon.png", "default/plymouth/logo.png", "default/sddm/omarchy/logo.png"):
    info = png_info(root / relative)
    if info[3] not in (4, 6):
        fail(f"{relative} has no alpha channel")
    if not png_has_transparent_pixel(root / relative):
        fail(f"{relative} does not contain both transparent and visible pixels")
print("ok - visible logo PNGs carry real alpha channels")

for relative in (
    "themes/maslow-dark/unlock.png",
    "themes/maslow-light/unlock.png",
    "default/plymouth/logo.png",
    "default/sddm/omarchy/logo.png",
):
    width, height, _, _ = png_info(root / relative)
    _, _, bounds = png_alpha_bounds(root / relative)
    content_center_x = (bounds[0] + bounds[2]) / 2
    if abs(content_center_x - width / 2) > 1:
        fail(f"{relative} visible lockup is {content_center_x - width / 2:.1f}px off center")
print("ok - graphical lockups center their visible content")
PY

pass "Maslow AI-OS brand validation passed"
